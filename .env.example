# Copy this to .env and fill in your values. Never commit .env.

# ── SHADZ Admin Core ────────────────────────────────────────────────────────
# Credentials for the /admin/* dashboard (HTTP Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Legacy internal API key ──────────────────────────────────────────────────
# Used by /status, /run-command, /nfc/* routes
SHADZ_OS_API_KEY=your-secret-key-here

# ── Telegram Bot Self-Service (Phase T1B) ─────────────────────────────────────
# Bot token from @BotFather. If unset, the bot fails safe (logs an error and
# skips sending) instead of crashing the app.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Required in production. Shared secret checked against Telegram's
# X-Telegram-Bot-Api-Secret-Token header. If unset, the webhook route fails
# closed (503) rather than accepting unauthenticated requests.
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here
# Public @username of the bot (no leading @), used to build Activation
# Engine v1 Phase A2 t.me deep links. If unset, the public Activation
# Gateway fails safe — it falls back to the slug's normal behaviour instead
# of redirecting into a broken deep link.
TELEGRAM_BOT_USERNAME=your_bot_username

# ── Safety Engine v1 Phase S6.1 (Telegram Reminder / Missed / Late / SOS) ────
# SHADZ Admin's Telegram chat id (a personal chat id or a group/channel id
# the bot has been added to). Receives missed-checkin, late-checkin, SOS,
# and SOS-escalation notifications. Uses the same TELEGRAM_BOT_TOKEN above
# to send. If unset, those Admin notifications fail safe (logged, not sent)
# — Safety DB state (check-ins, daily state, alerts, emergencies) is never
# affected either way.
#
# Early reminders do NOT use this variable as of S6.1 -- they route to each
# SafetyUser's own telegram_chat_id column instead (set per-user; a user
# with none configured simply never gets a reminder sent).
SAFETY_TELEGRAM_CHAT_ID=your-safety-admin-telegram-chat-id

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no setup needed, file created automatically)
DATABASE_URL=sqlite:///./shadz.db

# PostgreSQL (uncomment when ready to upgrade)
# DATABASE_URL=postgresql://shadz:shadz@localhost:5432/shadz_os

# ── Cloudflare R2 (Media Engine) ──────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=shadz-media
R2_PUBLIC_BASE_URL=https://media.shadz.io
# R2_ENDPOINT_URL is optional — derived from R2_ACCOUNT_ID if omitted
# R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
